/// A compiler-valid tour of Sagan syntax and editor features.

const STANDARD_ANSWER: Int = 42

fun 🚀(value: Int): Int => value + 2

fun fast_fibonacci(n: Int): Int {
  let i, a, b = 0, 0, 1
  while i++ <= n  a, b = b, a + b
  return b
}

face Readable {
  fun current(): Int
}

face Countable is Readable {
  fun increment!(): Int
  fun next(): Int => self.current() + 1
}

enum LaunchStatus {
  waiting
  ready
  launched
}

/** A mutable counter composed through the Countable interface. */
class LaunchCounter is Countable {
  let .value: Int

  new(start: Int) {
    self.value = start
  }

  /// Advances the counter and returns its new value.
  fun increment!(): Int {
    self.value += 1
    return self.value
  }

  fun .read_value(): Int => self.value

  fun current(): Int => self.read_value()
}

fun finish_early(): Int {
  hope return STANDARD_ANSWER
  finally print("Finally ran before an early return")
}

fun run_demo(): Int {
  let answer = 🚀(40)
  let fibonacci = fast_fibonacci(10)
  let first_five = 5.times
  const PHI = (1 + 5 ^ 0.5) / 2
  let rounded_power = Int.round(PHI ^ 5)
  let countdown_start = [3]
  let countdown_end = [1]
  let countdown = [...countdown_start, 2, ...countdown_end]
  let phase_defaults = {"countdown": 5, "liftoff": 1}
  let phases = {...phase_defaults, "countdown": 3}
  let configured_countdown = phases["countdown"]
  let launch_number = 0
  let squared = 3 ^ 2
  let reciprocal = 2.0 ^ -1
  let powered = 2
  powered ^= 3

  let arithmetic = 10
  arithmetic += 5
  arithmetic *= 2
  arithmetic /= 3
  arithmetic %= 6
  arithmetic -= 1

  let product = 6 * 7
  let floating_remainder = 5.5 % 2.0
  let scientific = 6.674_30e-11
  let direction_start = <1.0, 2.0>
  let direction = <...direction_start, 3.0>
  let position = (10.0, 20.0, 30.0)
  let direction_total = 0.0
  for component in direction direction_total += component

  let correction = <0.5, -1.0, 2.0>
  let adjusted_direction = direction + correction
  let restored_direction = adjusted_direction - correction
  let doubled_direction = 2.0 * direction
  let halved_direction = doubled_direction / 2.0
  let reversed_direction = -direction
  let maneuver_direction = direction
  maneuver_direction += correction
  maneuver_direction -= correction
  maneuver_direction *= 2.0
  maneuver_direction /= 2.0

  let guided_direction = direction
  guided_direction.x += 0.5
  guided_direction.y = 4.0

  let lambda_offset = 2
  let launch_transform = fun(value: Int): Int => value + lambda_offset
  let transformed_answer = launch_transform(40)
  let immediate_answer = (fun(value: Int): Int => value * 2)(21)
  let launch_counter = LaunchCounter(40)
  let counted_launch = launch_counter.increment!()
  let next_launch = launch_counter.next()
  let countable: Countable = launch_counter
  let dispatched_launch = countable.increment!()
  let launch_status = LaunchStatus.ready
  let guarded_answer = finish_early()
  let exception_state = 0

  let café = "Unicode identifiers work"
  let 🌌message = "${café}: answer ${answer}"
  let windows_path = r"C:\simulation\telemetry\${answer}"
  let report = """Sagan demo
Unicode: ${🌌message}
Scientific value: ${scientific}
"""

  hope {
    hope scream "launch abort"
    unless "different failure" exception_state = -1
    finally {
      exception_state += 2
      print("Inner finally ran before propagation")
    }
  } unless "launch abort" {
    exception_state += 40
    print("Outer unless caught the propagated value")
  }

  print("The answer from 🚀 is:")
  print(answer)
  print("Fibonacci: ${fibonacci}")
  print("First and last indices: ${first_five[0]}, ${first_five[4]}")
  print("Rounded power of PHI: ${rounded_power}")
  print("Countdown:")
  print("Configured countdown: ${configured_countdown}")
  print("Launch number before increment: ${launch_number++}")
  print("Launch number after prefix increment: ${++launch_number}")
  print("Three squared: ${squared}")
  print("Two to the negative one: ${reciprocal}")
  print("Two cubed through ^=: ${powered}")
  print("Checked compound arithmetic result: ${arithmetic}")
  print("Six times seven: ${product}")
  print("Floating remainder: ${floating_remainder}")
  print("Direction: ${direction}")
  print("Position: ${position}")
  print("Direction Z: ${direction.z}")
  print("Position Y: ${position.y}")
  print("Direction component total: ${direction_total}")
  print("Adjusted direction: ${adjusted_direction}")
  print("Reversed direction: ${reversed_direction}")
  print("Restored direction: ${restored_direction}")
  print("Guided direction: ${guided_direction}")
  print("Captured lambda result: ${transformed_answer}")
  print("Immediate lambda result: ${immediate_answer}")
  print("Class method result: ${counted_launch}")
  print("Class field result: ${launch_counter.current()}")
  print("Face default result: ${next_launch}")
  print("Face dispatch result: ${dispatched_launch}")
  print("Enum status: ${launch_status}")
  print("Exception state: ${exception_state}")
  print("Guarded return: ${guarded_answer}")
  print(windows_path)
  print(report)

  match launch_status {
    case LaunchStatus.ready print("Enum match selected ready")
    case else print("Enum match selected fallback")
  }
  match configured_countdown {
    case 3 print("Match selected the nominal countdown")
    case else print("Match selected the fallback")
  }
  for value in countdown print("Array item: ${value}")

  let ignition = 3
  while ignition > 0 {
    print("Ignition: ${ignition}")
    ignition -= 1
  }

  let launched = false
  until launched {
    print("Liftoff ${countdown[2]} 🚀")
    launched = true
  }

  if answer == STANDARD_ANSWER and transformed_answer == 42 and immediate_answer == 42 and counted_launch == 41 and next_launch == 42 and dispatched_launch == 42 and launch_counter.current() == 42 and launch_status == LaunchStatus.ready and exception_state == 42 and guarded_answer == 42 and launch_number == 2 and squared == 9 and reciprocal == 0.5 and powered == 8 and arithmetic == 3 and product == 42 and floating_remainder == 1.5 and direction_total == 6.0 and position.y == 20.0 and restored_direction == direction and halved_direction == direction and maneuver_direction == direction and reversed_direction.x == -1.0 and guided_direction.x == 1.5 and guided_direction.y == 4.0 return 0
  else return 1
}

exit(run_demo())
