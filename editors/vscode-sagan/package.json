{
  "name": "sagan-language",
  "displayName": "Sagan Language",
  "description": "Syntax highlighting and editor support for the Sagan programming language.",
  "version": "0.2.0",
  "publisher": "sagan-language",
  "icon": "images/sagan-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoePShoulak/sagan.git",
    "directory": "editors/vscode-sagan"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:sagan",
    "onCommand:sagan.showToolingStatus"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sagan",
    "language",
    "syntax-highlighting"
  ],
  "scripts": {
    "test": "node tests/run-tests.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "sagan.showToolingStatus",
        "title": "Sagan: Show Tooling Status"
      }
    ],
    "configuration": {
      "title": "Sagan",
      "properties": {
        "sagan.compiler.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the Sagan compiler. When empty, the extension checks the workspace bin directory and PATH."
        }
      }
    },
    "languages": [
      {
        "id": "sagan",
        "aliases": [
          "Sagan",
          "sagan"
        ],
        "extensions": [
          ".sagan"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sagan",
        "scopeName": "source.sagan",
        "path": "./syntaxes/sagan.tmLanguage.json"
      }
    ]
  }
}
