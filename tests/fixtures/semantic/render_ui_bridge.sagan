let opened: Bool = __render_ui_open("Responsive UI", 1280, 720)
let running: Bool = __render_ui_poll()
let width: Float64 = __render_ui_width()
let height: Float64 = __render_ui_height()
__render_ui_begin()
__render_ui_fill(12.0, 24.0, 320.0, 180.0, 24, 48, 96)
__render_ui_text(20.0, 36.0, "Telemetry", 18.0, 240, 240, 255)
__render_ui_present()
let escape_pressed: Bool = __render_ui_key_pressed("Escape")
let pointer_pressed: Bool = __render_ui_pointer_pressed()
let pointer_released: Bool = __render_ui_pointer_released()
let pointer_x: Float64 = __render_ui_pointer_x()
let pointer_y: Float64 = __render_ui_pointer_y()
__render_ui_close()
