enum Result<T, E> {
  Success(T)
  Failure(E)
}

fun identity<T>(value: T): T => value

fun describe(result: Result<Int, String>): String {
  match result {
    case Success(value) return "Result: ${value}"
    case Failure(message) return "Error: ${message}"
  }
}

fun main(): Int {
  let success: Result<Int, String> = Success(identity(42))
  let failure = Result<Int, String>.Failure(identity("guidance unavailable"))

  print(describe(success))
  print(describe(failure))

  if describe(success) == "Result: 42" return 0
  else return 1
}

exit(main())
