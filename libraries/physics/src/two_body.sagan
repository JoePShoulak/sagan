module two_body

/// Newtonian gravitational constant used by the P0 two-body solver.
const GRAVITATIONAL_CONSTANT: Float64<meter * meter * meter / kilogram / second^2> =
  6.67430e-11 (meter^3 / kilogram / second^2)

/// Read-only state for one body at a snapshot time.
class BodySnapshot {
  let .identity_value: String
  let .mass_value: Float64<kilogram>
  let .position_value: Point2<Float64, meter>
  let .velocity_value: Vector2<Float64, meter / second>

  new(identity: String, mass: Float64<kilogram>, position: Point2<Float64, meter>,
      velocity: Vector2<Float64, meter / second>) {
    self.identity_value = identity
    self.mass_value = mass
    self.position_value = position
    self.velocity_value = velocity
  }

  fun identity(): String => self.identity_value
  fun mass(): Float64<kilogram> => self.mass_value
  fun position(): Point2<Float64, meter> => self.position_value
  fun velocity(): Vector2<Float64, meter / second> => self.velocity_value
}

/// Immutable presentation and diagnostic state produced after a fixed step.
class TwoBodySnapshot {
  let .time_value: Float64<second>
  let .first_value: BodySnapshot
  let .second_value: BodySnapshot
  let .energy_value: Float64<joule>
  let .angular_momentum_value: Float64<kilogram * meter * meter / second>
  let .barycenter_value: Point2<Float64, meter>

  new(time: Float64<second>, first: BodySnapshot, second: BodySnapshot,
      energy: Float64<joule>,
      angular_momentum: Float64<kilogram * meter * meter / second>,
      barycenter: Point2<Float64, meter>) {
    self.time_value = time
    self.first_value = first
    self.second_value = second
    self.energy_value = energy
    self.angular_momentum_value = angular_momentum
    self.barycenter_value = barycenter
  }

  fun time(): Float64<second> => self.time_value
  fun first(): BodySnapshot => self.first_value
  fun second(): BodySnapshot => self.second_value
  fun energy(): Float64<joule> => self.energy_value
  fun angular_momentum(): Float64<kilogram * meter * meter / second> =>
    self.angular_momentum_value
  fun barycenter(): Point2<Float64, meter> => self.barycenter_value
}

/// Fixed-step Newtonian point-mass solver for exactly two bodies in one 2D frame.
class TwoBodySolver {
  let .first_identity: String
  let .second_identity: String
  let .first_mass: Float64<kilogram>
  let .second_mass: Float64<kilogram>
  let .first_position: Point2<Float64, meter>
  let .second_position: Point2<Float64, meter>
  let .first_velocity: Vector2<Float64, meter / second>
  let .second_velocity: Vector2<Float64, meter / second>
  let .step_duration: Float64<second>
  let .elapsed: Float64<second> = 0.0 second

  new(first_identity: String, first_mass: Float64<kilogram>,
      first_position: Point2<Float64, meter>,
      first_velocity: Vector2<Float64, meter / second>,
      second_identity: String, second_mass: Float64<kilogram>,
      second_position: Point2<Float64, meter>,
      second_velocity: Vector2<Float64, meter / second>,
      step_duration: Float64<second>) {
    assert(first_mass - first_mass == 0.0 kilogram, "two-body masses must be finite")
    assert(second_mass - second_mass == 0.0 kilogram, "two-body masses must be finite")
    assert(step_duration - step_duration == 0.0 second,
           "two-body step duration must be finite")
    assert(first_mass > 0.0 kilogram, "two-body masses must be positive")
    assert(second_mass > 0.0 kilogram, "two-body masses must be positive")
    assert(step_duration > 0.0 second, "two-body step duration must be positive")
    let first_speed_squared = squared_length(first_velocity)
    let second_speed_squared = squared_length(second_velocity)
    assert(squared_length(second_position - first_position) > 0.0 meter^2,
           "two-body positions must not overlap")

    self.first_identity = first_identity
    self.first_mass = first_mass
    self.first_position = first_position
    self.first_velocity = first_velocity
    self.second_identity = second_identity
    self.second_mass = second_mass
    self.second_position = second_position
    self.second_velocity = second_velocity
    self.step_duration = step_duration
  }

  fun .force(first_position: Point2<Float64, meter>,
             second_position: Point2<Float64, meter>):
      Vector2<Float64, newton> {
    let displacement = second_position - first_position
    let distance_squared = squared_length(displacement)
    assert(distance_squared > 0.0 meter^2, "two-body positions must not overlap")
    let direction = normalized(displacement)
    let magnitude = (6.67430e-11 (meter^3 / kilogram / second^2) *
      self.first_mass * self.second_mass /
      distance_squared) as newton
    return direction * magnitude
  }

  fun .energy_at(first_position: Point2<Float64, meter>,
                 first_velocity: Vector2<Float64, meter / second>,
                 second_position: Point2<Float64, meter>,
                 second_velocity: Vector2<Float64, meter / second>):
      Float64<joule> {
    let first_kinetic = 0.5 * self.first_mass * squared_length(first_velocity)
    let second_kinetic = 0.5 * self.second_mass * squared_length(second_velocity)
    let potential = -1.0 * GRAVITATIONAL_CONSTANT * self.first_mass * self.second_mass /
      length(second_position - first_position)
    return (first_kinetic + second_kinetic + potential) as joule
  }

  fun .angular_momentum_at(first_position: Point2<Float64, meter>,
                           first_velocity: Vector2<Float64, meter / second>,
                           second_position: Point2<Float64, meter>,
                           second_velocity: Vector2<Float64, meter / second>):
      Float64<kilogram * meter * meter / second> {
    let first = self.first_mass *
      (first_position.x * first_velocity.y - first_position.y * first_velocity.x)
    let second = self.second_mass *
      (second_position.x * second_velocity.y - second_position.y * second_velocity.x)
    return first + second
  }

  fun .barycenter_at(first_position: Point2<Float64, meter>,
                     second_position: Point2<Float64, meter>): Point2<Float64, meter> {
    let total_mass = self.first_mass + self.second_mass
    let offset = ((second_position - first_position) * self.second_mass /
                  total_mass) as meter
    return first_position + offset
  }

  /// Return a detached, read-only view of the current authoritative state.
  fun snapshot(): TwoBodySnapshot {
    let first = BodySnapshot(self.first_identity, self.first_mass,
                             self.first_position, self.first_velocity)
    let second = BodySnapshot(self.second_identity, self.second_mass,
                              self.second_position, self.second_velocity)
    return TwoBodySnapshot(
      self.elapsed, first, second,
      self.energy_at(self.first_position, self.first_velocity,
                     self.second_position, self.second_velocity),
      self.angular_momentum_at(self.first_position, self.first_velocity,
                               self.second_position, self.second_velocity),
      self.barycenter_at(self.first_position, self.second_position))
  }

  /// Advance both bodies by one explicit fixed step using velocity Verlet.
  fun step!(): TwoBodySnapshot {
    let old_force = self.force(self.first_position, self.second_position)
    let first_acceleration = old_force / self.first_mass
    let second_acceleration = -old_force / self.second_mass
    let half_step_squared = 0.5 * self.step_duration * self.step_duration

    let first_velocity_displacement =
      (self.first_velocity * self.step_duration) as meter
    let second_velocity_displacement =
      (self.second_velocity * self.step_duration) as meter
    let first_acceleration_displacement =
      (first_acceleration * half_step_squared) as meter
    let second_acceleration_displacement =
      (second_acceleration * half_step_squared) as meter
    let next_first_position = self.first_position + first_velocity_displacement +
      first_acceleration_displacement
    let next_second_position = self.second_position + second_velocity_displacement +
      second_acceleration_displacement

    let new_force = self.force(next_first_position, next_second_position)
    let next_first_acceleration = new_force / self.first_mass
    let next_second_acceleration = -new_force / self.second_mass
    let half_step = 0.5 * self.step_duration

    let first_velocity_change =
      ((first_acceleration + next_first_acceleration) * half_step) as (meter / second)
    let second_velocity_change =
      ((second_acceleration + next_second_acceleration) * half_step) as (meter / second)
    self.first_velocity = self.first_velocity + first_velocity_change
    self.second_velocity = self.second_velocity + second_velocity_change
    self.first_position = next_first_position
    self.second_position = next_second_position
    self.elapsed = self.elapsed + self.step_duration
    return self.snapshot()
  }
}

export GRAVITATIONAL_CONSTANT
export BodySnapshot
export TwoBodySnapshot
export TwoBodySolver

