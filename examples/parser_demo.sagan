face Renderable {
  fun render(): Frame
}

face Navigable is Renderable, Trackable {
  fun current_course(origin: Coordinate, destination: Coordinate): Vector
  fun status_label(): String {
    return "navigating"
  }
}

class ExplorerShip has Navigable, TelemetrySource {
  let name: String = "Voyager"
  let active = true
  fun render(): Frame {
    return self.renderer.draw(self)
  }
  fun .calculate_internal_state(): Vector {
    return self.position + self.velocity
  }
}

enum GuidanceStatus {
  waiting
  ready
  failed
}

let altitude: Float = 125_000.0
let target_altitude = (altitude)
let telemetry_pending
let orbital_energy = -2^3^2 + 4 * 5
let selected = telemetry_ready and altitude >= 100_000 ? altitude ; target_altitude
let captured = target_altitude := altitude := 125_500.0
let previous_count = telemetry_count++
let active_ship = fleet[active_index]
let course = fleet[active_index]?.navigator.current_course(origin, destination).magnitude()
let predicted_position = trajectory.sample!(simulation_time + time_step).position
let gravity = universe.systems[home_system].bodies[planet_index].gravity_at(ship.position)
let telemetry_value = mission?.telemetry.latest().channels[channel_index].sample_count++
let corrected_velocity = guidance.compute(ship.position, ship.velocity, target.position).normalized()
let mission_name = "Voyager"
let status = "mission ${mission_name}: altitude ${altitude}, course magnitude ${course}"
let archive_path = r"C:\simulation\telemetry\${mission_name}"
let formatted_name = "  ${mission_name}  ".trim().length()
let flight_report = """Mission report
Altitude and trajectory data are retained exactly.
Current altitude: ${altitude}
Computed course magnitude: ${course}
"""
let sensor_values = [1.0, ...baseline_samples, calculate_sample(altitude, course,),]
let mission_metadata = {
  "mission": mission_name,
  "active": true,
  active_ship.name: active_ship,
  ...default_metadata,
}
let thrust_direction = <
  1.0,
  0.0,
  0.0,
>
let orbital_position = (100.0, 200.0, altitude,)
let trajectory_samples = [
  orbital_position,
  (110.0, 205.0, altitude + 10.0,),
  ...historical_positions,
]
fun update_guidance(telemetry_ready: Bool, altitude: Float): GuidanceState {
  if telemetry_ready and altitude >= target_altitude {
    let next_course = navigator.current_course(orbital_position, target_position)
    ship.guidance.course = next_course
    ship.guidance.commit!()
  } else if retrying {
    telemetry.retry()
  } else {
    let fallback_course = guidance.safe_course(orbital_position)
    ship.guidance.course = fallback_course
  }
  for sample in trajectory_samples {
    if sample.invalid {
      continue
    }
    while sample.pending {
      sample.refresh!()
      if sample.failed {
        break
      }
    }
  }
  until guidance.converged {
    guidance.refine!(orbital_position, target_position)
  }
  match guidance.status {
    case "ready" {
      telemetry.record(guidance.state)
    }
    case "failed" {
      return
    }
    case else {
      guidance.wait()
    }
  }
  hope {
    telemetry.publish(guidance.state)
  } unless NetworkError {
    telemetry.queue(guidance.state)
  } unless error {
    scream telemetry.wrap(error)
  } finally {
    telemetry.flush!()
  }
  if guidance.failed {
    return
  }
  return guidance.state
}
