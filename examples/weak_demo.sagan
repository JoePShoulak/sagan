class Probe {
  let value: Int

  new(start: Int) {
    self.value = start
  }

  fun answer(): Int => self.value + 2
}

class Observer {
  weak let target: Probe

  fun watch!(value: Probe): Void {
    self.target = value
  }
}

fun observe_live(observer: Observer): Int {
  let probe = Probe(40)
  observer.watch!(probe)
  return observer.target?.answer() ?? 0
}

fun main(): Int {
  let observer = Observer()
  let live_answer = observe_live(observer)
  let expired_answer = observer.target?.answer() ?? -1

  print("Live weak reference: ${live_answer}")
  print("Expired weak reference fallback: ${expired_answer}")

  if live_answer == 42 and expired_answer == -1 return 0
  else return 1
}
