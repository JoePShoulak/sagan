fun 🚀(value: Int): Int => value + 2

fun main(): Int {
  let answer = 🚀(40)
  let countdown_start = [3]
  let countdown_end = [1]
  let countdown = [...countdown_start, 2, ...countdown_end]
  let phase_defaults = {"countdown": 5, "liftoff": 1}
  let phases = {...phase_defaults, "countdown": 3}
  let configured_countdown = phases["countdown"]
  let launch_number = 0
  let squared = 3 ^ 2
  let reciprocal = 2.0 ^ -1
  let powered = 2
  powered ^= 3
  let arithmetic = 10
  arithmetic += 5
  arithmetic *= 2
  arithmetic /= 3
  arithmetic %= 6
  arithmetic -= 1
  let product = 6 * 7
  let floating_remainder = 5.5 % 2.0
  let direction_start = <1.0, 2.0>
  let direction = <...direction_start, 3.0>
  let position = (10.0, 20.0, 30.0)
  let direction_total = 0.0
  for component in direction direction_total += component
  let correction = <0.5, -1.0, 2.0>
  let adjusted_direction = direction + correction
  let restored_direction = adjusted_direction - correction
  let doubled_direction = 2.0 * direction
  let halved_direction = doubled_direction / 2.0
  let reversed_direction = -direction
  let maneuver_direction = direction
  maneuver_direction += correction
  maneuver_direction -= correction
  maneuver_direction *= 2.0
  maneuver_direction /= 2.0
  let guided_direction = direction
  guided_direction.x += 0.5
  guided_direction.y = 4.0

  print("The answer from 🚀 is:")
  print(answer)
  print("Countdown:")
  print("Configured countdown: ${configured_countdown}")
  print("Launch number before increment: ${launch_number++}")
  print("Launch number after prefix increment: ${++launch_number}")
  print("Three squared: ${squared}")
  print("Two to the negative one: ${reciprocal}")
  print("Two cubed through ^=: ${powered}")
  print("Checked compound arithmetic result: ${arithmetic}")
  print("Six times seven: ${product}")
  print("Floating remainder: ${floating_remainder}")
  print("Direction: ${direction}")
  print("Position: ${position}")
  print("Direction Z: ${direction.z}")
  print("Position Y: ${position.y}")
  print("Direction component total: ${direction_total}")
  print("Adjusted direction: ${adjusted_direction}")
  print("Reversed direction: ${reversed_direction}")
  print("Restored direction: ${restored_direction}")
  print("Guided direction: ${guided_direction}")
  match configured_countdown {
    case 3 print("Match selected the nominal countdown")
    case else print("Match selected the fallback")
  }
  for value in countdown print("Array item: ${value}")

  let ignition = 3
  while ignition > 0 {
    print("Ignition: ${ignition}")
    ignition -= 1
  }

  let launched = false
  until launched {
    print("Liftoff ${countdown[2]} 🚀")
    launched = true
  }

  if answer == 42 and launch_number == 2 and squared == 9 and reciprocal == 0.5 and powered == 8 and arithmetic == 3 and product == 42 and floating_remainder == 1.5 and direction_total == 6.0 and position.y == 20.0 and restored_direction == direction and halved_direction == direction and maneuver_direction == direction and reversed_direction.x == -1.0 and guided_direction.x == 1.5 and guided_direction.y == 4.0 return 0
  else return 1
}
