fun 🚀(value: Int): Int => value + 2

fun main(): Int {
  let answer = 🚀(40)
  let countdown = [3, 2, 1]
  let phases = {"countdown": 3, "liftoff": 1}
  let configured_countdown = phases["countdown"]

  print("The answer from 🚀 is:")
  print(answer)
  print("Countdown:")
  print("Configured countdown: ${configured_countdown}")
  match configured_countdown {
    case 3 {
      print("Match selected the nominal countdown")
    }
    case else {
      print("Match selected the fallback")
    }
  }
  for value in countdown {
    print("Array item: ${value}")
  }

  let ignition = 3
  while ignition > 0 {
    print("Ignition: ${ignition}")
    ignition -= 1
  }

  let launched = false
  until launched {
    print("Liftoff ${countdown[2]} 🚀")
    launched = true
  }

  if answer == 42 {
    return 0
  } else {
    return 1
  }
}
