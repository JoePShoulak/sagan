fun 🚀(value: Int): Int => value + 2

fun main(): Int {
  let answer = 🚀(40)
  let countdown = [3, 2, 1]

  print("The answer from 🚀 is:")
  print(answer)
  print("Countdown:")
  for value in countdown {
    print("Array item: ${value}")
  }

  let ignition = 3
  while ignition > 0 {
    print("Ignition: ${ignition}")
    ignition -= 1
  }

  let launched = false
  until launched {
    print("Liftoff ${countdown[2]} 🚀")
    launched = true
  }

  if answer == 42 {
    return 0
  } else {
    return 1
  }
}
