enum Result {
  Success(Int) = 200
  Failure(String) = 500
  Coordinates(Int, Int)
  Pending = -1
}

fun describe(result: Result): String {
  match result {
    case Success(value) return "Result: ${value}"
    case Failure(message) return "Error: ${message}"
    case Coordinates(x, y) return "Coordinates: ${x}, ${y}"
    case Result.Pending return "Pending"
  }
}

fun main(): Int {
  let success = Success(42)
  let failure = Failure("guidance unavailable")
  let coordinates = Coordinates(3, 4)
  let pending = Result.Pending

  print(describe(success))
  print(describe(failure))
  print(describe(coordinates))
  print(describe(pending))

  if describe(success) == "Result: 42" return 0
  else return 1
}
